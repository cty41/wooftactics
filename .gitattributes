# Autodetect text files and keep repository text byte-stable across platforms.
* text=auto eol=lf

# Specific rules
*.cs  text eol=lf
*.cpp text eol=lf
*.c   text eol=lf
*.h   text eol=lf
*.txt text eol=lf

# Godot text resources and import metadata remain reviewable in regular Git.
*.godot    text eol=lf
*.tscn     text eol=lf
*.tres     text eol=lf
*.gd       text eol=lf
*.gdshader text eol=lf
*.import   text eol=lf
*.uid      text eol=lf
*.cfg      text eol=lf

# Preserve the reviewed upstream vendor snapshot without rewriting its two trailing blank lines.
godot/addons/godot_ai/** whitespace=-blank-at-eof

# Generated Godot gameplay plans are byte-compared against Node output.
Tests/gameplay-specs/godot/*.plan.json text eol=lf

# Frozen source snapshots are preserved byte-for-byte for migration archaeology.
src/Tactics.FrozenOracle.Tests/FrozenSources/** -whitespace

# Immutable compiled artwork prompts preserve generator-emitted trailing separators.
Tools/artworks/**/prompts/compiled/*.md whitespace=-blank-at-eof
Tools/artworks/**/pipeline/*compiled*.md whitespace=-blank-at-eof
Tools/artworks/**/equipment/prompts/*compiled*.md whitespace=-blank-at-eof

