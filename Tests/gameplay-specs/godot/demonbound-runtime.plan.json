{
  "schemaVersion": 3,
  "runtime": "Godot",
  "scenarioName": "Demonbound.RuntimeState",
  "requiredAdapters": [
    "Map",
    "PlayerInput",
    "UI",
    "Battle"
  ],
  "requiredCapabilities": [
    "action:restartGodotMain",
    "action:useBattleSkillThroughInput",
    "action:waitForPlayerObservable",
    "assertion:battleSkillReceiptEquals",
    "assertion:demonboundCorruptionEquals",
    "assertion:demonboundPossessedEquals",
    "assertion:productionSaveUnchanged",
    "assertion:runtimeHasNoErrors",
    "setup:initializePlayerInput",
    "setup:loadValidatedCheckpoint"
  ],
  "setupActions": [
    {
      "adapter": "Map",
      "kind": "loadValidatedCheckpoint",
      "parameters": {
        "id": "demonbound-ready-v1",
        "path": "validated://demonbound-ready-v1",
        "semanticHash": "6a6cd1044c7a51332edc0d347970565df0b4f5dd22e08dd4ede2e316aef9c5df"
      }
    },
    {
      "adapter": "PlayerInput",
      "kind": "initializePlayerInput",
      "parameters": {}
    }
  ],
  "runtimeActions": [
    {
      "adapter": "UI",
      "kind": "restartGodotMain",
      "parameters": {}
    },
    {
      "adapter": "PlayerInput",
      "kind": "waitForPlayerObservable",
      "parameters": {
        "observable": "battleReady",
        "maximumFrames": 300
      }
    },
    {
      "adapter": "PlayerInput",
      "kind": "useBattleSkillThroughInput",
      "parameters": {
        "actorId": "party-pure_run_demonbound",
        "skillId": "skill.demonbound.bane.lv1",
        "maximumActions": 40
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Battle",
      "kind": "demonboundCorruptionEquals",
      "target": "party-pure_run_demonbound",
      "expected": 3,
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "demonboundPossessedEquals",
      "target": "party-pure_run_demonbound",
      "expected": false,
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "battleSkillReceiptEquals",
      "expected": {
        "actorId": "party-pure_run_demonbound",
        "skillId": "skill.demonbound.bane.lv1",
        "corruption": 3
      },
      "parameters": {}
    },
    {
      "adapter": "UI",
      "kind": "runtimeHasNoErrors",
      "expected": true,
      "parameters": {}
    },
    {
      "adapter": "Map",
      "kind": "productionSaveUnchanged",
      "expected": true,
      "parameters": {}
    }
  ],
  "timeoutMs": 30000,
  "probeRequests": [
    {
      "adapter": "Battle",
      "kind": "demonboundCorruptionEquals",
      "target": "party-pure_run_demonbound",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "demonboundPossessedEquals",
      "target": "party-pure_run_demonbound",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "battleSkillReceiptEquals",
      "parameters": {}
    },
    {
      "adapter": "UI",
      "kind": "runtimeHasNoErrors",
      "parameters": {}
    },
    {
      "adapter": "Map",
      "kind": "productionSaveUnchanged",
      "parameters": {}
    }
  ],
  "checkpoint": {
    "id": "demonbound-ready-v1",
    "source": "validated_checkpoint",
    "semanticHash": "6a6cd1044c7a51332edc0d347970565df0b4f5dd22e08dd4ede2e316aef9c5df",
    "path": "validated://demonbound-ready-v1"
  },
  "saveIsolation": {
    "root": "user://qa-runner",
    "protectProductionSave": true
  },
  "watchdog": {
    "stepTimeoutMs": 30000,
    "battleRoundLimit": 80,
    "scenarioTimeoutMs": 300000,
    "noProgressLimit": 2
  }
}
