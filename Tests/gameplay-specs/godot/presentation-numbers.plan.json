      "kind": "productionSaveUnchanged",
      "parameters": {}
    }
  ],
  "checkpoint": {
    "id": "numbers-mana-v1",
    "source": "validated_checkpoint",
    "semanticHash": "0600ff730fc74de5e9ef3c81b59db38f6ddf64dbec9e45a8e8ef82a14fb65b75",
    "path": "validated://numbers-mana-v1"
  },
  "saveIsolation": {
