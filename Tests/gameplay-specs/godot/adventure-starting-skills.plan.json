{
  "schemaVersion": 3,
  "runtime": "Godot",
  "scenarioName": "AdventureBoard.StartingSkillsEnterAdventureBoard",
  "requiredAdapters": [
    "Map",
    "PlayerInput",
    "UI"
  ],
  "requiredCapabilities": [
    "action:clickPointerTarget",
    "action:waitForPlayerObservable",
    "assertion:activePartyStartingSkillIdsEqual",
    "assertion:productionSaveUnchanged",
    "assertion:runtimeHasNoErrors",
    "setup:initializePlayerInput"
  ],
  "setupActions": [
    {
      "adapter": "PlayerInput",
      "kind": "initializePlayerInput",
      "parameters": {}
    }
  ],
  "runtimeActions": [
    {
      "adapter": "PlayerInput",
      "kind": "waitForPlayerObservable",
      "parameters": {
        "observable": "adventureBoardReady",
        "maximumFrames": 180
      }
    },
    {
      "adapter": "PlayerInput",
      "kind": "clickPointerTarget",
      "target": "pure_run_amazon",
      "parameters": {
        "targetKind": "AdventureActor"
      }
    },
    {
      "adapter": "PlayerInput",
      "kind": "clickPointerTarget",
      "target": "pure_run_demonbound",
      "parameters": {
        "targetKind": "AdventureActor"
      }
    },
    {
      "adapter": "PlayerInput",
      "kind": "clickPointerTarget",
      "target": "pure_run_mage",
      "parameters": {
        "targetKind": "AdventureActor"
      }
    },
    {
      "adapter": "PlayerInput",
      "kind": "clickPointerTarget",
      "target": "start-exit",
      "parameters": {
        "targetKind": "AdventureObject"
      }
    },
    {
      "adapter": "PlayerInput",
      "kind": "waitForPlayerObservable",
      "target": "starting_skill__skill_amazon_thrust_lv1",
      "parameters": {
        "observable": "uiElement",
        "elementName": "starting_skill__skill_amazon_thrust_lv1",
        "maximumFrames": 180
      }
    },
    {
      "adapter": "PlayerInput",
      "kind": "clickPointerTarget",
      "target": "starting_skill__skill_amazon_thrust_lv1",
      "parameters": {
        "targetKind": "UiElement"
      }
    },
    {
      "adapter": "PlayerInput",
      "kind": "waitForPlayerObservable",
      "target": "starting_skill__skill_mage_fireball_lv1",
      "parameters": {
        "observable": "uiElement",
        "elementName": "starting_skill__skill_mage_fireball_lv1",
        "maximumFrames": 180
      }
    },
    {
      "adapter": "PlayerInput",
      "kind": "clickPointerTarget",
      "target": "starting_skill__skill_mage_fireball_lv1",
      "parameters": {
        "targetKind": "UiElement"
      }
    },
    {
      "adapter": "PlayerInput",
      "kind": "waitForPlayerObservable",
      "parameters": {
        "observable": "adventureBoardReady",
        "maximumFrames": 180
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Map",
      "kind": "activePartyStartingSkillIdsEqual",
      "expected": [
        "skill.amazon.thrust.lv1",
        "skill.demonbound.mindfulness.lv1",
        "skill.mage.fireball.lv1"
      ],
      "parameters": {}
    },
    {
      "adapter": "UI",
      "kind": "runtimeHasNoErrors",
      "expected": true,
      "parameters": {}
    },
    {
      "adapter": "Map",
      "kind": "productionSaveUnchanged",
      "expected": true,
      "parameters": {}
    }
  ],
  "timeoutMs": 30000,
  "probeRequests": [
    {
      "adapter": "Map",
      "kind": "activePartyStartingSkillIdsEqual",
      "parameters": {}
    },
    {
      "adapter": "UI",
      "kind": "runtimeHasNoErrors",
      "parameters": {}
    },
    {
      "adapter": "Map",
      "kind": "productionSaveUnchanged",
      "parameters": {}
    }
  ],
  "saveIsolation": {
    "root": "user://qa-runner",
    "protectProductionSave": true
  },
  "watchdog": {
    "stepTimeoutMs": 30000,
    "battleRoundLimit": 80,
    "scenarioTimeoutMs": 300000,
    "noProgressLimit": 2
  }
}
